# Root environment (fake values only). Compose reads the POSTGRES_* section.
# Backend settings below are a full reference; the running backend reads
# backend/.env (see backend/.env.example), so copy these there.

# --- docker-compose (Postgres + Valkey) ---
# PostgreSQL database name for the local Docker service
POSTGRES_DB=ai_receptionist
# PostgreSQL username for local development only
POSTGRES_USER=ai_receptionist
# Replace this local-only placeholder before using the service beyond localhost
POSTGRES_PASSWORD=change-me-local-only

# --- backend reference (copy to backend/.env; validated by src/config/env.ts) ---
# Runtime environment: local | dev | staging | prod (dev auth refused outside local/dev)
APP_ENV=local
# HTTP listen port (bound to 127.0.0.1)
PORT=8000
# Log verbosity: debug | info | warn | error
LOG_LEVEL=info
# Timezone for calling windows and rendering times
DEFAULT_TIMEZONE=Africa/Lagos
# Comma-separated CORS allow-list for the dashboard
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# App role (ai_receptionist_app, RLS enforced). Used by the running app and DB tests.
DATABASE_URL=postgresql://ai_receptionist_app:change-me-app-local-only@127.0.0.1:5433/ai_receptionist
# Owner role. Used ONLY by db:migrate and db:seed, never by the running app.
DATABASE_MIGRATION_URL=postgresql://ai_receptionist:change-me-local-only@127.0.0.1:5433/ai_receptionist
# Valkey connection URL for the backend
VALKEY_URL=redis://127.0.0.1:6379/0
# Local-only dev token (min 24 chars) mapping to DEV_TENANT_ID. Refused outside local/dev.
DEV_ACCESS_TOKEN=local-dev-token-CHANGE-ME-0123456789abcdef
# Tenant the dev token maps to; matches the db:seed demo tenant id
DEV_TENANT_ID=0195f3a0-0000-7000-8000-000000000001
# Cartesia API key for hosted streaming STT/TTS (ADR 0007)
CARTESIA_API_KEY=sk-cartesia-fake-local-only
# Cartesia API version header
CARTESIA_VERSION=2025-04-16
# Cartesia STT model
STT_MODEL=ink-whisper
# STT language (English only for now; Cartesia lacks Yoruba/Igbo/Hausa/Pidgin)
STT_LANGUAGE=en
# Cartesia TTS model
TTS_MODEL=sonic-2
# Cartesia voice "seun" (Nigerian accent); confirm commercial licence before pilot
TTS_VOICE=63b389ff-8a8c-4013-a4d6-df3b893812df
# TTS output sample rate in Hz
TTS_SAMPLE_RATE=24000
# Muse API key for the LLM adapter (OpenAI-compatible endpoint, ADR 0007)
MUSE_API_KEY=sk-muse-fake-local-only
# OpenAI-compatible chat-completions base URL (provider stays swappable)
LLM_BASE_URL=https://api.meta.ai/v1
# LLM model id
LLM_MODEL=muse-spark-1.3-contributor
# Reasoning effort for live turns: minimal | low | medium | high
LLM_REASONING_EFFORT=minimal
# Cap on completion tokens per turn
LLM_MAX_COMPLETION_TOKENS=400
# End-of-turn silence the browser VAD waits for, in ms (AGENTS.md 10.3)
ENDPOINTING_SILENCE_MS=600
