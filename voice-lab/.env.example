# Local-only model paths; keep real paths and credentials in an ignored .env.
KOKORO_MODEL_PATH=models/kokoro/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=models/kokoro/voices-v1.0.bin
WAVTOKENIZER_ROOT=models/wavtokenizer/WavTokenizer
WAVTOKENIZER_CONFIG_PATH=models/wavtokenizer/wavtokenizer-config.yaml
WAVTOKENIZER_CHECKPOINT_PATH=models/wavtokenizer/wavtokenizer-checkpoint.ckpt
WAVTOKENIZER_DEVICE=cpu
MODEL_CACHE_DIR=models/cache
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
TTS_VOICE=af_sarah
DEMO_LANGUAGE=en-NG

# LLM loop defaults to a local Ollama-compatible endpoint.
LITELLM_MODEL=ollama/qwen2.5:3b
LITELLM_BASE_URL=http://localhost:11434
