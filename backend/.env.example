# Copy to .env for local development. Fake values only; never commit real keys.
APP_ENV=local
PORT=8000
LOG_LEVEL=info
DEFAULT_TIMEZONE=Africa/Lagos
# Comma-separated browser origins allowed for HTTP and voice WebSocket
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# App role (non-owner so row-level security applies). Not needed for the voice loop alone.
DATABASE_URL=postgresql://ai_receptionist:change-me-local-only@127.0.0.1:5433/ai_receptionist
# Owner role for migrations and seeding only, never by the running app
# DATABASE_MIGRATION_URL=postgresql://owner:change-me@127.0.0.1:5433/ai_receptionist
VALKEY_URL=redis://127.0.0.1:6379/0

# Local-only stand-in for real auth: requests with ?token=DEV_ACCESS_TOKEN act as DEV_TENANT_ID.
# Refused outside local/dev. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DEV_ACCESS_TOKEN=replace-with-random-32-plus-char-token
DEV_TENANT_ID=0195f3a0-0000-7000-8000-000000000001

# Cartesia speech (ADR 0007). REST + WebSocket auth is `Authorization: Bearer`.
CARTESIA_API_KEY=sk_car_replace-me
CARTESIA_VERSION=2025-04-16
# Realtime STT model (ink-whisper is batch-only; the manual WebSocket uses ink-2)
STT_MODEL=ink-2
STT_LANGUAGE=en
# Current low-latency TTS model; seun voice id below works with it
TTS_MODEL=sonic-3.6
# Cartesia voice "seun" (Nigerian accent)
TTS_VOICE=63b389ff-8a8c-4013-a4d6-df3b893812df
TTS_SAMPLE_RATE=24000

# Muse Spark via the OpenAI-compatible Meta endpoint (ADR 0007)
MUSE_API_KEY=replace-me
LLM_BASE_URL=https://api.meta.ai/v1
LLM_MODEL=muse-spark-1.3-contributor
# minimal is fastest for live turns; none is rejected by this reasoning model
LLM_REASONING_EFFORT=minimal
# Keep generous: reasoning tokens count against this budget (too small => empty replies)
LLM_MAX_COMPLETION_TOKENS=400

# End-of-turn silence the browser VAD waits for, in ms (AGENTS.md 10.3)
ENDPOINTING_SILENCE_MS=600
