# Local API service used by the dashboard
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Voice gateway WebSocket (no trailing path beyond /v1/voice)
NEXT_PUBLIC_VOICE_WS_URL=ws://127.0.0.1:8000/v1/voice
# Local-only stand-in for real auth: must match backend DEV_ACCESS_TOKEN.
# Never use this in production; the browser cannot keep a secret.
NEXT_PUBLIC_DEV_ACCESS_TOKEN=replace-with-backend-dev-access-token
# End-of-turn silence the browser VAD waits for, in ms (matches backend ENDPOINTING_SILENCE_MS)
NEXT_PUBLIC_ENDPOINTING_SILENCE_MS=600
